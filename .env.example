# Copy to .env.local - never commit that file.

# Auto-injected by `vercel env pull`; leave blank otherwise.
VERCEL_OIDC_TOKEN=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Auth.js session secret - generate with: npx auth secret
AUTH_SECRET=

# Google OAuth credentials (console.cloud.google.com)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
